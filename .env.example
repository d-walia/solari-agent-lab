# Solari — get this from https://console.getsolari.com (starts with slr_live_)
SOLARI_API_KEY=slr_live_xxxxxxxxxxxxxxxxxxxxxxxx

# The LLM that drives the agents/personas. Anthropic by default.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# Max environments to run at once. Set to your Solari plan's concurrency cap.
# The worker pool saturates this and no more.
MAX_CONCURRENCY=8
